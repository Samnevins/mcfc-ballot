generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Enum-like strings (SQLite has no enums):
// Role: SUPPORTER | ADMIN
// UserStatus: PENDING | APPROVED | REJECTED | SUSPENDED (only APPROVED can sign in)
// AllocationStatus: PENDING | ACCEPTED | RETURNED | EXPIRED
// HomeAway: HOME | AWAY
// Competition: PREMIER_LEAGUE | FA_CUP | CARABAO_CUP | CHAMPIONS_LEAGUE | OTHER
// WeightReason: UNSUCCESSFUL | ACCEPTED | RETURNED | EXPIRED | PENALTY_USED | GROUP_WON | ADMIN

model User {
  id               String        @id @default(cuid())
  email            String        @unique
  name             String
  passwordHash     String
  role             String        @default("SUPPORTER")
  status           String        @default("PENDING")
  phone            String?
  membershipNumber String?
  weight           Float         @default(1.0)
  banGamesLeft     Int           @default(0)
  reducedGamesLeft Int           @default(0)
  createdAt        DateTime      @default(now())
  applications     Application[]
  allocations      Allocation[]
  weightLogs       WeightLog[]
  drawsRun         Draw[]
  groupMember      GroupMember?
  groupsLed        Group[]
}

model Group {
  id        String        @id @default(cuid())
  name      String
  code      String        @unique // join code shared by the leader
  leaderId  String
  leader    User          @relation(fields: [leaderId], references: [id])
  createdAt DateTime      @default(now())
  members   GroupMember[]
}

model GroupMember {
  id       String   @id @default(cuid())
  groupId  String
  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId   String   @unique // one group per supporter
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime @default(now())
}

model WeightLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameId     String?
  game       Game?    @relation(fields: [gameId], references: [id], onDelete: SetNull)
  reason     String
  oldWeight  Float
  newWeight  Float
  banLeft    Int
  reducedLeft Int
  createdAt  DateTime @default(now())

  @@index([userId])
}

model Game {
  id                  String        @id @default(cuid())
  opponent            String
  venue               String
  homeAway            String        @default("HOME")
  competition         String        @default("PREMIER_LEAGUE")
  kickoff             DateTime
  applicationDeadline DateTime
  drawAt              DateTime
  ticketsAvailable    Int
  createdAt           DateTime      @default(now())
  applications        Application[]
  draws               Draw[]
  allocations         Allocation[]
  weightLogs          WeightLog[]
}

model Application {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameId    String
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  // Set when applying as part of a group. Plain string (no FK) so closed
  // applications stay grouped even if the group is later changed or deleted.
  groupId   String?
  createdAt DateTime @default(now())

  @@unique([userId, gameId])
  @@index([gameId, groupId])
}

model Draw {
  id          String       @id @default(cuid())
  gameId      String
  game        Game         @relation(fields: [gameId], references: [id], onDelete: Cascade)
  round       Int
  seed        Int
  ticketCount Int
  inputJson   String // DrawEntry[] (see src/lib/ballot.ts)
  orderJson   String // ranked entry ids
  ranById     String
  ranBy       User         @relation(fields: [ranById], references: [id])
  ranAt       DateTime     @default(now())
  allocations Allocation[]

  @@unique([gameId, round])
}

model Allocation {
  id          String    @id @default(cuid())
  drawId      String
  draw        Draw      @relation(fields: [drawId], references: [id], onDelete: Cascade)
  gameId      String
  game        Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      String    @default("PENDING")
  respondBy   DateTime
  respondedAt DateTime?

  @@unique([gameId, userId])
}

model Settings {
  id                Int   @id @default(1)
  weightIncrement   Float @default(0.5)
  reducedMultiplier Float @default(0.5)
  acceptWindowHours Int   @default(48)
}
